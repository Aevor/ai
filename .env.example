# Application configuration
APP_NAME=Aevor AI
ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Server network binding (Default port 11434 matches Aevor Platform AI_SERVICE_URL default)
HOST=0.0.0.0
PORT=11434
# Namespaced aliases (optional):
# AI_SERVICE_HOST=0.0.0.0
# AI_SERVICE_PORT=11434

# Model Provider settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Diff Summarizer limits
MAX_DIFF_SIZE_CHARS=100000
